{
  "manifest_version": 3,
  "name": "ClipForge Capture",
  "version": "0.1.1",
  "description": "One-click send the current page's video to your local ClipForge app.",
  "permissions": ["activeTab", "scripting", "contextMenus", "notifications"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Add page video to ClipForge",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
